{
	frankenphp
	order php_server before file_server
}

{$SERVER_NAME:localhost} {
	log {
		output stderr
		format console
	}

	root * /app/public

	# Compression primero (antes de cualquier otra respuesta)
	encode zstd gzip

	# Long cache para assets estaticos
	@static {
		path *.css *.js *.jpg *.jpeg *.png *.gif *.svg *.webp *.avif *.woff *.woff2 *.ttf *.ico
	}
	header @static Cache-Control "public, max-age=2592000"

	# Serve PHP + static files
	php_server
}
